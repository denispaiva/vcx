{
  "color": {
    "paper":      {"value": "#F5EEDF", "role": "app background (pegboard dot pattern on --peg)"},
    "peg":        {"value": "#E6DAC0", "role": "pegboard dots, decorative only"},
    "card":       {"value": "#FFFDF8", "role": "card, search, tab bar surfaces"},
    "ink":        {"value": "#1E2B24", "role": "primary text, outlines, hard shadows"},
    "ink-2":      {"value": "#4F5A52", "role": "secondary text (>=6:1 on paper/card)"},
    "line":       {"value": "#D9CFB8", "role": "quiet borders on inactive chips"},
    "green":      {"value": "#14573F", "role": "brand, selected state, links"},
    "green-soft": {"value": "#DCEBDD", "role": "available-now badge fill, active tab pill"},
    "available-ink": {"value": "#0E4631", "role": "text on green-soft"},
    "orange":     {"value": "#B93A0B", "role": "primary action (Lend a tool), focus ring"},
    "orange-pressed": {"value": "#9A2F07", "role": "pressed state of primary action"},
    "on-primary": {"value": "#FFFFFF", "role": "text/icons on green and orange"},
    "amber-soft": {"value": "#F8E4B8", "role": "available-from-date badge fill"},
    "amber-ink":  {"value": "#6B4300", "role": "text on amber-soft"},
    "photo": {"value": ["#F2C14E", "#9FC9B2", "#EFA48A", "#B9CDE0"], "role": "photo placeholder backdrops"}
  },
  "font": {
    "body": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "display": "Rockwell, 'Roboto Slab', Georgia, 'Times New Roman', serif"
  },
  "typeScale": {
    "h1":    {"size": 30, "lineHeight": 36, "weight": 700, "family": "display"},
    "h2":    {"size": 22, "lineHeight": 28, "weight": 700, "family": "display"},
    "cta":   {"size": 17, "weight": 700, "family": "display"},
    "cardTitle": {"size": 16, "lineHeight": 20, "weight": 700, "family": "display"},
    "input": {"size": 16, "weight": 400, "family": "body"},
    "label": {"size": 14, "weight": 600, "family": "body"},
    "meta":  {"size": 13, "lineHeight": 18, "weight": 400, "family": "body"},
    "badge": {"size": 12, "lineHeight": 16, "weight": 700, "family": "body"},
    "tab":   {"size": 12, "weight": 600, "family": "body"}
  },
  "spacing": {"unit": 4, "scale": [4, 8, 12, 16, 24], "screenGutter": 16, "gridGap": 12},
  "radii": {"sm": 10, "md": 16, "lg": 22, "pill": 999},
  "border": {"outline": "1.5-2px solid ink", "hardShadow": "3px 3px 0 ink"},
  "touch": {"minTarget": 44, "chip": 44, "search": 52, "cta": 56, "tab": 48}
}
